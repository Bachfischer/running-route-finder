{
  "name": "running-route-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests *.mjs *.ts --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=\"lib/*.ts\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 tests/*.test.mjs",
    "test:memory": "node --max-old-space-size=96 --experimental-strip-types scripts/test-memory.mjs",
    "test:live": "node --experimental-strip-types scripts/live-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "format": "prettier --write app components lib scripts tests .github docs *.json *.yaml *.mjs *.ts README.md",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "test:ui": "playwright test",
    "test:server": "node scripts/test-server.mjs",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@vercel/functions": "3.9.7",
    "leaflet": "1.9.4",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.26.0"
}
